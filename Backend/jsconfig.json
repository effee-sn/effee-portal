{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@modules/*": ["src/modules/*"],
      "@lib/*": ["src/lib/*"]
    }
  },
  "include": ["src/**/*.js", "prisma/**/*.js"],
  "exclude": ["node_modules", "dist"]
}
