# ── Runtime ───────────────────────────────────────────────────────────────────

# development | production
# Configuration problems are tolerated with a warning in development and are
# fatal in production.
NODE_ENV=development

# HTTP port the Express server listens on. On Azure App Service leave it unset:
# the platform sets PORT itself.
PORT=4000

# Number of reverse proxies in front of this app (nginx, ALB, Cloudflare, ...).
# Express walks this many entries back through X-Forwarded-For to resolve
# req.ip. Rate limiting depends on it: too high lets clients spoof their IP,
# too low puts every client in one shared bucket. Leave at 0 when the app is
# exposed directly with no proxy. Azure App Service: 1 (its front end).
TRUST_PROXY_HOPS=0

# ── Security ──────────────────────────────────────────────────────────────────

# JWT signing secret — minimum 32 characters, required.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars

# JWT token lifetime (zeit/ms format: 15m, 12h, 7d)
JWT_EXPIRES_IN=7d

# bcrypt work factor. Higher is slower and stronger; 12 is the current
# sensible floor. Raising it later is safe — the cost is stored in each hash.
BCRYPT_ROUNDS=12

# Browser origins permitted to call this API, comma-separated.
# The first entry is also used as the base URL for password-reset links.
ALLOWED_ORIGIN=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────

# Prisma / MySQL connection string
DATABASE_URL="mysql://user:password@localhost:3306/effeeportal"
#
# Azure Database for MySQL (Flexible Server) — add these options:
#   DATABASE_URL="mysql://user:password@<server>.mysql.database.azure.com:3306/effeeportal?sslaccept=strict&connection_limit=10&pool_timeout=20&max_idle_connection_lifetime=180"
#   sslaccept=strict                  encrypted connection, server certificate checked
#   connection_limit=10               connections per app instance (Prisma's default
#                                     is CPUs x 2 + 1 — only 3 on a 1-vCPU plan)
#   pool_timeout=20                   seconds a query waits for a free connection
#   max_idle_connection_lifetime=180  replace connections idle 3 min — Azure drops
#                                     ones idle about 4 min, which would fail the next query
# Keep connection_limit x instances below the server's max_connections.

# ── Seeding ───────────────────────────────────────────────────────────────────

# Bootstrap Super Admin account created by `node prisma/seed.js`.
# Leave SEED_ADMIN_PASSWORD unset in development and the seeder generates a
# random password and prints it once. It is REQUIRED when NODE_ENV=production —
# the seeder refuses to invent a credential that might go unread.
SEED_ADMIN_EMAIL=admin@admin.com
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_PHONE=9000000000

# ── Browser push (optional) ───────────────────────────────────────────────────

# Web Push (VAPID) keys for desktop notifications. All optional — when unset,
# push is disabled and in-app notifications still work. Browser push also
# requires the site to be served over HTTPS (localhost excepted).
# Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@yourdomain.com

# ── Email / SMTP (optional) ───────────────────────────────────────────────────

# Outbound email for notifications and password resets. SMTP is configured
# here only (not in the database); changes need a restart. When SMTP_HOST is
# empty, email is disabled and the app still runs.
#
# Two modes:
#  - Authenticated: set SMTP_USER + SMTP_PASS.
#      Office 365: SMTP_HOST=smtp.office365.com  SMTP_PORT=587
#      Gmail:      SMTP_HOST=smtp.gmail.com      SMTP_PORT=587  (use an App Password)
#  - No authentication (relay / Microsoft 365 Direct Send): leave SMTP_USER and
#    SMTP_PASS empty and set SMTP_FROM_EMAIL to an address on your domain.
#      SMTP_HOST=<tenant>.mail.protection.outlook.com  SMTP_PORT=25
#    Direct Send only delivers to mailboxes in your own Microsoft 365 tenant,
#    and the server must be allowed to send out on port 25.
# Port 465 uses implicit TLS; other ports use STARTTLS when the server offers it.
#
# Effee Induction uses Microsoft 365 Direct Send (no authentication):
#  - the server must be able to reach port 25 outbound (check on the VPS with
#    `nc -vz effeeinduction-com01c.mail.protection.outlook.com 25`);
#  - only @effee-induction.com mailboxes receive mail, so every portal user
#    needs an address on that domain;
#  - add the server's public IP to the effee-induction.com SPF record so mail
#    doesn't land in Junk.
SMTP_HOST=effeeinduction-com01c.mail.protection.outlook.com
SMTP_PORT=25
# Leave both empty for Direct Send (no login).
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Effee Portal
# Required for Direct Send — any address @effee-induction.com.
SMTP_FROM_EMAIL=noreply@effee-induction.com

# Email every in-app notification (ticket, sales, handoffs, reminders) to the
# recipient. Password-reset emails are sent regardless of this switch.
EMAIL_NOTIFICATIONS=true

# ── Microsoft sign-in (SSO, Microsoft Entra ID) ───────────────────────────────
# Optional. Register the portal as an app in Entra ID (single tenant), then fill
# these in. SSO is offered only when all four are set AND an administrator
# switches it on in Administrator → Settings → Security.
#   MS_SSO_REDIRECT_URI  must be registered in Entra exactly as written here:
#                        https://<your-domain>/api/v1/auth/sso/microsoft/callback
#                        (http://localhost:<port>/... is allowed for local testing)
#   MS_SSO_ALLOWED_GROUP_ID  optional: Object ID of the Entra group allowed in.
#                        Also add the "groups" claim (Token configuration) so
#                        the portal can check it. Recommended in addition:
#                        Enterprise app → Properties → "Assignment required" = Yes.
MS_SSO_TENANT_ID=
MS_SSO_CLIENT_ID=
MS_SSO_CLIENT_SECRET=
MS_SSO_REDIRECT_URI=
MS_SSO_ALLOWED_GROUP_ID=

# ── File storage: Azure Blob (optional) ───────────────────────────────────────
# Files stay on this server until these are set AND a Super Admin switches Blob
# on in Settings → Storage (which can also copy the existing files across).
# Give the connection string (Storage account → Access keys), or name + key.
# The container is private and created automatically.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=effee-portal

# ── Reminders & timezone ──────────────────────────────────────────────────────
# Business timezone for wall-clock rules, independent of the server's timezone.
APP_TIMEZONE=Asia/Kolkata
# Follow-ups / reviews with a time are reminded this many minutes before.
FOLLOWUP_REMINDER_LEAD_MINUTES=15
# Follow-ups with a date only are reminded at this time that day (HH:MM).
FOLLOWUP_REMINDER_DAY_TIME=09:00
