{
  "name": "backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test --test-reporter=spec \"tests/unit/**/*.test.js\"",
    "test:watch": "node --test --watch \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test --test-reporter=spec --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "test:all": "node --test --test-reporter=spec --test-concurrency=1 \"tests/**/*.test.js\"",
    "seed": "node prisma/seed.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "setup": "prisma generate && prisma db push && node prisma/seed.js",
    "deploy": "prisma generate && prisma migrate deploy && node prisma/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Odoo-style RBAC boilerplate — Express + Prisma + MySQL",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
